# Build context: repository root (see docker-compose.yml / README)
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY backend/ .
RUN dotnet restore IntegrationFramework.slnx
RUN dotnet publish src/IntegrationFramework.Api/IntegrationFramework.Api.csproj \
    -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8000 \
    DOTNET_EnableDiagnostics=0
EXPOSE 8000
# 'app' user ships with the .NET runtime image (uid 1654)
USER app
ENTRYPOINT ["dotnet", "IntegrationFramework.Api.dll"]
