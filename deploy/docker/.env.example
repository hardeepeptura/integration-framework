# Copy to deploy/docker/.env (gitignored) and fill in.
# SQL Server container SA password (compose-managed mssql service)
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!

# Optional: point the framework at your own SQL Server / Azure SQL instead of the container.
# METADATA_CONNECTION_STRING=Server=your-server.database.windows.net,1433;Database=YourDb;User Id=youruser;Password=yourpassword;TrustServerCertificate=True

# Passwords for DB connector connections used by workflows (names must match
# each connection's password_env field, e.g. MSSQL_PASSWORD for the sample connection):
# MSSQL_PASSWORD=
# POSTGRES_PASSWORD=
# MYSQL_PASSWORD=
