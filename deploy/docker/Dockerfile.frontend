# Build context: repository root (see docker-compose.yml / README)
FROM node:22-alpine AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-fund --no-audit
COPY frontend/ .
# The in-app Help page bundles docs/How-To-Build-Workflows.md (prebuild copies
# it from ../docs into src/), so the docs folder must exist in the image.
COPY docs/ /docs
RUN npm run build

FROM nginx:alpine AS runtime
COPY --from=build /src/dist /usr/share/nginx/html
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
